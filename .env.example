# Smart Energy Management System Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace_this_with_a_secure_random_key_in_production

# Database Configuration
# In Render: Automatically provided as DATABASE_URL
# In Local: Can leave blank for SQLite fallback or set to PostgreSQL URI
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_energy_db

# Default System Settings
DEFAULT_TARIFF_PER_KWH=120.0
LOW_CONSUMPTION_THRESHOLD=5.0
MODERATE_CONSUMPTION_THRESHOLD=10.0
